NEXT_PUBLIC_SUPABASE_URL=https://ydftuowqlrlgjrubiqcx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key

OPENAI_API_KEY=server_only_ai_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional external AI video rendering (paid; leave blank for free mode)
RUNWAYML_API_SECRET=server_only_runway_key
RUNWAY_VIDEO_MODEL=gen4.5

# Free Hugging Face ZeroGPU video worker
HUGGINGFACE_ZERO_GPU_URL=https://YOUR-SPACE-NAME.hf.space
HUGGINGFACE_TOKEN=server_only_huggingface_token

# Optional local GPU worker. Keep the worker URL private unless protected by a tunnel/auth layer.
LOCAL_GPU_WORKER_URL=http://127.0.0.1:8787
LOCAL_GPU_WORKER_TOKEN=server_only_random_worker_token

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://YOUR_PRODUCTION_DOMAIN/api/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=32-byte-key-as-64-hex-characters
YOUTUBE_STATE_SECRET=strong-random-secret
CRON_SECRET=strong-random-secret

# Never commit .env.local. Never expose SUPABASE_SERVICE_ROLE_KEY, AI keys, Runway keys, Hugging Face tokens, OAuth secrets, or worker tokens as NEXT_PUBLIC_* variables.
